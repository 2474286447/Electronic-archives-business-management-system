# React history 路由部署示例：
# 1. root 指向当前 React 项目的 dist 目录
# 2. /login、/dashboard 等前端路由通过 try_files 回落到 index.html
# 3. 前端生产接口基址为 /archives-admin，与当前 8081 代理入口保持一致
server {
  listen 8081;
  server_name localhost;

  root /home/admin/app/archive/dist;
  index index.html index.htm;

  location / {
    try_files $uri $uri/ /index.html;
  }

  location = /favicon.ico {
    try_files $uri =404;
  }

  location /archives-admin/ {
    proxy_pass http://8.129.36.219:9088/archives-admin/;
    proxy_http_version 1.1;
    proxy_redirect off;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    client_max_body_size 30m;
    proxy_connect_timeout 30s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
  }
}
